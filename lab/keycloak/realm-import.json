{
  "realm": "api-lab",
  "enabled": true,
  "displayName": "API-Schulung Lab Realm",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "api-user",
        "description": "Standard-Benutzerrolle fuer API-Aufrufe"
      },
      {
        "name": "api-admin",
        "description": "Administratorrolle fuer geschuetzte Endpunkte"
      }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Lab",
      "email": "alice@api-lab.local",
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME_LAB_USER_PASS",
          "temporary": false
        }
      ],
      "realmRoles": [
        "api-user"
      ]
    },
    {
      "username": "bob-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Admin",
      "email": "bob@api-lab.local",
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME_LAB_ADMIN_PASS",
          "temporary": false
        }
      ],
      "realmRoles": [
        "api-user",
        "api-admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "bruno-pkce-client",
      "name": "Bruno PKCE Public Client (OAuth 2.1)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/callback",
        "http://localhost:12345/callback",
        "http://127.0.0.1:12345/callback",
        "https://oauth.usebruno.com/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "api-lab-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "api-lab-orders",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "m2m-service-client",
      "name": "M2M Service Client (Client Credentials)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_LAB_M2M_SECRET",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-lab-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "api-lab-orders",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "m2m-introspect-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "m2m-service-client",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "soapui-lab-client",
      "name": "SoapUI Lab Contrast Client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_LAB_SOAPUI_SECRET",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/callback",
        "http://localhost:9090/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "legacy-ropc-audit-client",
      "name": "DEPRECATED Legacy ROPC Audit Client (NUR FUER M10 NEGATIV-AUDIT)",
      "description": "DEPRECATED: Resource Owner Password Credentials ist nach RFC 9700 und OAuth 2.1 entfernt. Nur fuer Migrations-Audits im Schulungslabor.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_LAB_ROPC_SECRET",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    }
  ]
}
