# ==============================================================================
# Labor-Umgebungsvariablen (NUR FUER LOKALES DOCKER-LAB — KEINE PRODUKTIV-SECRETS)
# Kopiere diese Datei nach lab/.env:  cp lab/.env.example lab/.env
# ==============================================================================

# Keycloak Admin (lokale Dev-Instanz)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_LAB_ADMIN

# Keycloak OAuth/OIDC Clients (Realm: api-lab)
KC_M2M_CLIENT_ID=m2m-service-client
KC_M2M_CLIENT_SECRET=CHANGE_ME_LAB_M2M_SECRET
KC_SOAPUI_CLIENT_ID=soapui-lab-client
KC_SOAPUI_CLIENT_SECRET=CHANGE_ME_LAB_SOAPUI_SECRET
KC_ROPC_LEGACY_CLIENT_ID=legacy-ropc-audit-client
KC_ROPC_LEGACY_CLIENT_SECRET=CHANGE_ME_LAB_ROPC_SECRET

# Keycloak Test-Benutzer
LAB_USER_ALICE=alice
LAB_USER_ALICE_PASSWORD=CHANGE_ME_LAB_USER_PASS
LAB_USER_BOB=bob-admin
LAB_USER_BOB_PASSWORD=CHANGE_ME_LAB_ADMIN_PASS

# Lokaler SOAP/WSDL + WS-Security-Service (Port 9000)
SOAP_WSS_USER=lab-wss-user
SOAP_WSS_PASS=CHANGE_ME_LAB_WSS_PASS

# Zertifikate & Java-Keystores (M07 / M08 / Capstone)
LAB_CERT_PASSWORD=CHANGE_ME_LAB_ONLY

# go-httpbin Test-Credentials (M05)
HTTPBIN_BASIC_USER=labuser
HTTPBIN_BASIC_PASS=CHANGE_ME_LAB_HTTPBIN
HTTPBIN_API_KEY=CHANGE_ME_LAB_API_KEY
HTTPBIN_BEARER_TOKEN=CHANGE_ME_LAB_STATIC_BEARER
